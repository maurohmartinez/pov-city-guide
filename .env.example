###################################################
#            APP                                  #
###################################################

APP_NAME="POV City Guide"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Europe/Bucharest"
APP_URL=http://localhost

###################################################
#         DEVELOPMENT                             #
###################################################

# BASSET_DEV_MODE=true
# Use the existing "public" disk so basset bakes APP_URL (https) into asset URLs
# and serves them through the standard public/storage symlink.
# BASSET_DISK=public
# The local domain uses a self-signed cert, so skip verification when basset
# fetches first-party assets (referenced via asset()) over https.
# BASSET_VERIFY_SSL_CERTIFICATE=false

# Laravel Dusk
# DUSK_HEADLESS_DISABLED=true # Uncomment this variable to see the tests as they run
# DUSK_DRIVER_URL=http://localhost:9515

# Backpack DevTools
# DEVTOOLS_EDITOR=phpStorm

# Local dev using Sail
# APP_SERVICE=povcityguide
# FORWARD_DB_PORT=3307
# FORWARD_REDIS_PORT=6380

# Password-less "login as any user" route: /backoffice/tools/login?user_id=1
# Only honoured when APP_ENV=local. Never enable this anywhere else.
# DEV_LOGIN_ENABLED=true

###################################################
#         MAINTENANCE                             #
###################################################

# Key for error logging service
FLARE_KEY=
FLARE_TRACE=true

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Maintenance mode
APP_MAINTENANCE_DRIVER=file

###################################################
#            SECURITY                             #
###################################################

BCRYPT_ROUNDS=12

###################################################
#            DATABASE                             #
###################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

###################################################
#            SESSION                              #
###################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

###################################################
#            QUEUE                               #
###################################################

QUEUE_CONNECTION=database

###################################################
#            CACHE                               #
###################################################

CACHE_STORE=database
CACHE_PREFIX=

###################################################
#            MAIL                                 #
###################################################

# ----------------
# All Environments
# ----------------
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="contact@example.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"

# -------------------------
# Local/Staging Environment
# -------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# ----------------------
# Production Environment
# ----------------------
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxx...

###################################################
#            LANGUAGE                             #
###################################################

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=en,ro

###################################################
#            CURRENCY                             #
###################################################

COUNTRY_CODE=RO
CURRENCY_ISO=RON
CURRENCY_LOCALE=ro-RO

###################################################
#            AUTO TRANSLATION                     #
###################################################

# AUTO_TRANSLATE_ENABLED=true
# AUTO_TRANSLATE_DRIVER=deepl
# AUTO_TRANSLATE_QUEUE=translations

# --------------
# Deepl Settings
# --------------
# DEEPL_API_KEY="xxx"
# DEEPL_API_URL="https://api-free.deepl.com" # for localhost

# ---------------
# OpenAI Settings
# ---------------
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_ORGANIZATION=org-xxx
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# --------------
# Prism Settings
# --------------
# PRISM_PROVIDER=openai
# PRISM_MODEL=gpt-4o-mini
# PRISM_TEMPERATURE=0.2
# PRISM_MAX_TOKENS=2000
# PRISM_TIMEOUT=120
# OPENAI_API_KEY=sk-proj-xxx

###################################################
#            FEATURE FLAGS                        #
###################################################

#COLOR_MODE=light_and_dark
