####################################################
#         ENV FILE FOR LOCAL DUSK TESTING          #
####################################################
# Will be used when running dusk on localhost.

# Notes:
# - uses mysql database

# Uncomment this variable to see the tests as they run
#DUSK_HEADLESS_DISABLED=true

APP_NAME=testingPOVCITYGUIDE
APP_ENV=testing
APP_KEY=base64:TZkUFhOxzx/GOtWO7ok0bpQoqQttQTB6K1sCyDJOckY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://pov-city-guide.local:8890
#APP_URL=http://localhost

# Local dev using Sail
#APP_SERVICE=ticketingapp
#FORWARD_DB_PORT=3307
#FORWARD_REDIS_PORT=6380

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=bg,en,ro

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=Inbox-Name
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
